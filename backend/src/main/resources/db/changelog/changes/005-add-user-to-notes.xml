<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="005-add-user-to-notes" author="elizabeth">
        <!-- Existing notes predate per-user ownership and have no owner to assign them to. -->
        <sql>DELETE FROM note_categories;</sql>
        <sql>DELETE FROM notes;</sql>

        <addColumn tableName="notes">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint baseTableName="notes"
                                  baseColumnNames="user_id"
                                  referencedTableName="users"
                                  referencedColumnNames="id"
                                  constraintName="fk_notes_user"
                                  onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
