<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="006-add-user-to-categories" author="elizabeth">
        <!-- Existing categories predate per-user ownership and have no owner to assign them to. -->
        <sql>DELETE FROM note_categories;</sql>
        <sql>DELETE FROM categories;</sql>

        <!-- Uniqueness moves from global (one "Work" for everyone) to per-user (each user can have their own "Work"). -->
        <sql>ALTER TABLE categories DROP CONSTRAINT categories_name_key;</sql>

        <addColumn tableName="categories">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint baseTableName="categories"
                                  baseColumnNames="user_id"
                                  referencedTableName="users"
                                  referencedColumnNames="id"
                                  constraintName="fk_categories_user"
                                  onDelete="CASCADE"/>

        <addUniqueConstraint tableName="categories"
                              columnNames="user_id, name"
                              constraintName="uq_categories_user_name"/>
    </changeSet>

</databaseChangeLog>
